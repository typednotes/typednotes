# Copy to .env.local and use: bash scripts/dev.sh
# Loaded only into the local server environment; never into the WASM client.
DATABASE_URL='postgres://postgres:postgres@127.0.0.1:5432/typednotes'
PUBLIC_URL='http://localhost:8080'
TYPEDNOTES_BACKGROUND=0

# Sign-in: register PUBLIC_URL/auth/github/callback or /auth/google/callback.
# GITHUB_CLIENT_ID=''
# GITHUB_CLIENT_SECRET=''
# GOOGLE_CLIENT_ID=''
# GOOGLE_CLIENT_SECRET=''

# For a remote backend, DATABASE_URL must reach that broker's core/ledger DB.
# Point these at VPN-accessible addresses or local SSH/port-forward tunnels.
# SECRETS_URL='http://127.0.0.1:18200'
# SECRETS_USERNAME='typednotes-app'
# SECRETS_PASSWORD=''
# LIAISON_URL='http://127.0.0.1:18081'
# LIAISON_ROOT_KEY=''
# LODE_URL='http://127.0.0.1:18082'
# LODE_TOKEN=''
# LUN_URL='http://127.0.0.1:18083'
# LUN_TOKEN=''

# Addresses reachable FROM REMOTE RUNNERS, not the laptop's tunnel addresses.
# LIAISON_RUNTIME_URL='http://liaison:8080'
# COMPUTE_DB_URL='postgres://provisioner:password@127.0.0.1:15433/compute'
# COMPUTE_DB_RUNTIME_URL='postgres://compute-db:5432/compute'
